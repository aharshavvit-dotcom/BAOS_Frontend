# ── Database ──────────────────────────────────────────────
DB_PASS=your_postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5433/baos
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:your_postgres_password@localhost:5433/baos

# ── JWT (REQUIRED — no default, app will not start without this) ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8001
DEBUG=true

# ── ML ────────────────────────────────────────────────────
MIN_TRAINING_ROWS=100
ML_RANDOM_STATE=42
ML_VALIDATION_SIZE=0.20
BERTH_LIMIT_INFERENCE_FACTOR=0.95

# ── RL (experimental) ────────────────────────────────────
RL_DELAY_WEIGHT=1.0
RL_IDLE_WEIGHT=0.3
RL_MISMATCH_WEIGHT=0.5

# ── Currency ──────────────────────────────────────────────
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
PORT_CHARGES_PER_HOUR=100.0

# ── Tide Data ─────────────────────────────────────────────
# Set to True and provide TIDE_DATA_PATH for real hydrographic data
USE_REAL_TIDE_DATA=false
TIDE_DATA_PATH=
BERTH_DEPTH_BUFFER=1.5

# ── Redis / Celery (optional) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── Notes ─────────────────────────────────────────────────
# PostgreSQL runs on port 5433 (non-standard) to avoid conflicts
# with any existing PostgreSQL instance on the default port 5432.
# Change DB_PORT in settings.py if your PostgreSQL uses a different port.
